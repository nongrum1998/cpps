# ── Dependencies ────────────────────────────────────────────────
node_modules/
npm-debug.*

# ── Expo / Metro ────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Environment / secrets (never commit) ───────────────────────
.env*
!.env.sample

# ── Native build artifacts / signing ────────────────────────────
*.apk
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Native ios/android dirs (generated per app by EAS/prebuild) ─
apps/*/ios/
apps/*/android/

# ── Worktrees / scratch / residue ───────────────────────────────
.worktrees
.metro-health-check*
*.orig.*
ignore*

# ── Per-app tooling caches / local env files ────────────────────
apps/*/.export-verify
apps/*/http/http-client.env.json

# ── App's pre-monorepo git history (archived, never committed) ──
# apps/pension was its own git repo before the monorepo was created.
# Its .git was moved to .git-archived to keep the root repo able to
# track the app files; this keeps the original history on disk while
# keeping it out of the monorepo index.
apps/pension/.git-archived/

# ── macOS ───────────────────────────────────────────────────────
.DS_Store