{
  "name": "@pension/types",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pension/eslint-config": "workspace:*",
    "@pension/prettier-config": "workspace:*",
    "@pension/typescript-config": "workspace:*",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "axios": "^1.13.0",
    "prettier": "3.2.5",
    "typescript": "6.0.3"
  }
}
