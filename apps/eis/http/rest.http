### 13. Create leave (use-create-leave → insert_update_leave, flag: "N")
POST {{host}}/make_request
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "functionName": "insert_update_leave",
  "emp_cd": "2009200083T",
  "leave_cd": "CL",
  "from_dt": "2026-08-10",
  "to_dt": "2026-08-12",
  "no_days": "2",
  "order_dt": "2026-08-05",
  "order_no": "123",
  "remarks": null,
  "reason_text": "Family event",
  "reason_cd": "1",
  "flag": "N"
}

### 14. Update leave (use-update-leave → insert_update_leave, flag: "E")
POST {{host}}/make_request
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "functionName": "insert_update_leave",
  "emp_cd": "2009200083T",
  "leave_cd": "CL",
  "from_dt": "2026-08-10",
  "to_dt": "2026-08-12",
  "no_days": "2",
  "order_dt": "2026-08-05",
  "order_no": "123",
  "remarks": null,
  "reason_text": "Family event",
  "reason_cd": "1",
  "flag": "E"
}

