# ═══════════════════════════════════════════════════════════════════════════
# EIS — REST API Reference
#
# Covers every API the app calls:
#   - Auth:  OAuth2 token, login, sign-up, OTP, reset password, refresh
#   - RPC:   all `make_request` function names from src/shared/utils/constants/method.ts
#   - Base:  sign-up / OTP / reset / refresh POST directly to {{host}} (no path)
#
# Usage (VS Code "REST Client" extension):
#   1. Run "OAuth2 client-credentials token" → response handler captures the
#      access token into the @token variable automatically.
#   2. Run any RPC request below; they all use Bearer {{token}}.
# ═══════════════════════════════════════════════════════════════════════════
@oauthHost = {{EXPO_PUBLIC_API_OAUTH_URL}}
@host = {{EXPO_PUBLIC_API_URL}}
@basicAuth = {{EXPO_PUBLIC_BASIC_AUTH}}
@token = eyJ4NXQiOiJNell4TW1Ga09HWXdNV0kwWldObU5EY3hOR1l3WW1NNFpUQTNNV0kyTkRBelpHUXpOR00wWkdSbE5qSmtPREZrWkRSaU9URmtNV0ZoTXpVMlpHVmxOZyIsImtpZCI6Ik16WXhNbUZrT0dZd01XSTBaV05tTkRjeE5HWXdZbU00WlRBM01XSTJOREF6WkdRek5HTTBaR1JsTmpKa09ERmtaRFJpT1RGa01XRmhNelUyWkdWbE5nX1JTMjU2IiwiYWxnIjoiUlMyNTYifQ..VENBqbVqiLG6VrfGpaxE6JLNd4xdphn4FdEwGeZbdoH4itJiPkSBRVlQlSicYn0oMuY3jzK6j0bQ0CdGm9WGKOhgR21LNhARu1SU5jPHb41HXtKIkYLdGfABDbtlPHz1xreR4uA9wCScpUZ1Eri0_eejDBPsH-RF40OhVyqlhNk6Sd6dtbwUW771vQS1EpePSvKe_og9ODclbe2JlknVxjav_ZoSKFNyyUc07NKeHwUMahDpCpvjkWjq4T20jO2W20fV7NYOjxOpfrsTzL_bLscZAFwp_16UQf734yfaUxI86Xn3FHQKsgBIGzdtvrywhiPBSVIGudaod-_8iUAewg


# ═══════════════════════════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════════════════════════

### 1. OAuth2 client-credentials token (use-get-oauth-token)
# @kulala-curl-k
# @name oauthToken
POST {{oauthHost}}/oauth2/token
Authorization: Basic {{basicAuth}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials

### 2. Employee login (use-login-mutation → employee_login)
# @name login
# @kulala-curl-k
POST {{host}}/make_request
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "functionName": "employee_login",
  "emp_cd": "2009200083T",
  "password": "MeghE1TSE"
} 

