### pension logout
POST {{BASE_URL}}/logout

{
 "token":"{{ACCESS_TOKEN}}"
}

# ----------------------------
# Response
# ----------------------------
# {
#   "message": "success"
#   "status": true,
# }
# ----------------------------

### get-ppo-status 
POST {{BASE_URL}}/get_ppo_status
Content-Type: application/json

# ----------------------------
# Payload
# ----------------------------
# { 
#   "pp_no":"[Redacted]"
# }
# ----------------------------

{
 "payload":"{{PAYMENT_SLIP_PAYLOAD}}"
}

# ----------------------------
# Response
# ----------------------------
# {
#   "payload": {
#     "ppo_no": "string",
#     "pname": "string",
#     "dob": "string",
#     "bank_accno": "string"
#   }
# }
# "success": true | false
# }
# ----------------------------
