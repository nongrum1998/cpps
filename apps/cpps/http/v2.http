### --------------------------------------------
### Login
### --------------------------------------------
# ------------ Pre-script -------------------
< {%
   require("./scripts/enc-req.http.js");
%}

POST {{BASE_URL}}/login

# ----------------------------
# Payload
# ----------------------------
{
  "username":"MG/11xx",  
  "password":"D@phne123"
}
# ----------------------------

# ------------ Post-script -------------------
> {%
   require("./scripts/dec-res.http.js");
%}

# ----------------------------
# Response
# ----------------------------
# {
#   "data": {
#     "token": "[Redacted]"
#   },
#   "message": "Authenticate",
#   "success": true
# }
# ----------------------------
