# --------------------------------------------
# Pensioner v2
# --------------------------------------------

###  login
POST {{BASE_URL}}/login
# ----------------------------
# Payload
# ----------------------------
# { 
#   "username":"[Redacted]",
#   "password":"[Redacted]"
# }
# ----------------------------


{
  "payload":"{{LOGIN_PAYLOAD}}"
}

# ----------------------------
# Response
# ----------------------------
# {
#   "data": {
#     "token": "[Redacted]"
#   },
#   "message": "Authenticate",
#   "success": true
# }
# ----------------------------

###  pension statement
POST {{BASE_URL}}/paymentslip

# ----------------------------
# Payload
# ----------------------------
# { 
#   "pp_no":"[Redacted]"
# }
# ----------------------------

{
  "payload":"{{PAYMENT_SLIP_PAYLOAD}}"
}
