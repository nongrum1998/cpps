### --------------------------------------------
### Pension logout
### --------------------------------------------
# ------------ Pre-script -------------------
< {%
   require("./scripts/enc-req.http.js");
%}

POST {{BASE_URL}}/logout

# ----------------------------
# Payload
# ----------------------------
{ "token":"{{ACCESS_TOKEN}}" }
# ----------------------------

# ------------ Post-script -------------------
> {%
   require("./scripts/dec-res.http.js");
%}

# ----------------------------
# Response
# ----------------------------
# {
#   "message": "success",
#   "status": true
# }
# ----------------------------
