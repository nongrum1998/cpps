{
  "name": "cpps",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear --localhost",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\" && tsc --noEmit",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "preview:local": "eas build --profile preview --platform android --local --output 'build-preview-$(date +%d-%m-%Y-%H%M).apk'",
    "preview": "eas build --profile preview --platform android --output 'build-preview-$(date +%d-%m-%Y-%H%M).apk'",
    "development:local": "eas build --profile development --platform android --local --output 'build-development-$(date +%d-%m-%Y-%H%M).apk'",
    "development": "eas build --profile development --platform android --output 'build-development-$(date +%d-%m-%Y-%H%M).apk'",
    "export": "expo export",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react-native": "1.0.16",
    "@pension/core": "workspace:*",
    "@pension/api": "workspace:*",
    "@pension/utils": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "crypto-js": "4.2.0",
    "expo": "57.0.18",
    "expo-application": "57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "57.0.16",
    "expo-device": "57.0.1",
    "expo-file-system": "57.0.6",
    "expo-image-manipulator": "57.0.14",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-screen-capture": "57.0.2",
    "expo-secure-store": "57.0.2",
    "expo-sharing": "57.0.18",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "expo-updates": "57.0.19",
    "jail-monkey": "^3.0.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.85.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "2.32.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-face-detector": "2.0.6",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@pension/jest-config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/crypto-js": "4.2.2",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.9",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.2",
    "expo-dev-client": "57.0.16",
    "jest-expo": "~57.0.0",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.11",
    "tailwindcss": "3.4.0",
    "typescript": "6.0.3"
  },
  "private": true
}
