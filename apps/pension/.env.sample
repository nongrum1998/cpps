# cssp-mobile environment variables
# Copy to .env and fill in values. NEVER commit .env.

# --- Build variant (EAS build profiles) ------------------------------------
# [CONFIG] development | preview. Leave unset for production.
EXPO_PUBLIC_APP_VARIANT=development

# --- API base URL -----------------------------------------------------------
# [CONFIG] safe to log key name; value is a public URL.
EXPO_PUBLIC_API_URL=https://your-api.example.com/api/cpps/PensionersApp/v1
EXPO_PUBLIC_DAT_API_URL=https://your-api.example.com/api/cpps/PensionersApp/v1

# --- Client-side Fernet key (legacy obfuscation protocol) -------------------
# [SECRET] never log the value. Ships inside the app bundle — treat as
# obfuscation only, not real encryption (M1 deferred).
EXPO_PUBLIC_FERNET_KEY=

# --- DEV-ONLY automation credentials ----------------------------------------
# [DEV-ONLY] EXPO_PUBLIC_* values are compiled into the JS bundle. NEVER set
# these in the EAS production profile; doing so ships working credentials.
EXPO_PUBLIC_PPO_NO=
EXPO_PUBLIC_PASSWORD=

# --- REST Client (.http) dev tokens -----------------------------------------
# [DEV-ONLY] populated from a fresh login; never commit real values.
# ACCESS_TOKEN=
# RENEW_TOKEN=
# PPO_NO=
# PASSWORD=
