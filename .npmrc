# pnpm install settings for this monorepo.
#
# hoist=false disables pnpm's hidden hoist (`node_modules/.pnpm/node_modules`).
#
# This workspace holds two React Native majors on purpose: apps/cpps and
# apps/pension on Expo 57 / RN 0.86.x, and apps/eis on Expo 54 / RN 0.81.x.
# By default pnpm hoists every transitive dependency into one store-wide
# directory shared by all importers, so any package that imports something it
# does not declare resolves it from that shared directory — letting a lookup
# that starts inside apps/eis silently land on apps/cpps's SDK generation.
#
# Metro makes this reachable in practice: it resolves an import by walking up
# from the *importing file* before consulting the app's own `node_modules`,
# and pnpm lets a package's declared dependencies answer first. An import that
# nothing in the chain declares therefore falls through to the shared hoist.
# Observed in apps/eis (Expo 54) resolving RN 0.86.3, expo-constants 57.x and
# react-native-css-interop 0.2.6 that way, which broke Metro codegen with
# "Unable to determine event arguments for onModeChange".
#
# With hoisting off, a package resolves only what its own manifest declares
# (its own `node_modules`, plus the app's `node_modules` for app code via
# Metro's `nodeModulesPaths`). A missing declaration surfaces as a hard
# resolution error instead of a silent cross-SDK import.
hoist=false
